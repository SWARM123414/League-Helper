{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LoL Scout",
  "version": "2.0.0",
  "identifier": "com.lolscout.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data:; connect-src 'self' ipc: http://ipc.localhost https://ddragon.leagueoflegends.com; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "LoL Scout",
    "longDescription": "Mostra contra quem vais jogar no League of Legends: rank, winrate, duos, mains, tilt, smurfs, histórico e muito mais.",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Portuguese", "English", "Spanish", "French"],
        "displayLanguageSelector": false
      }
    }
  }
}
